# ============================================
# SUPABASE
# ============================================
# Dipakai di client (browser) — aman untuk publik
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# HANYA dipakai di server (Route Handler). JANGAN pernah diawali NEXT_PUBLIC_
# dan JANGAN pernah di-commit ke git dengan nilai asli.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# BUATQRIS.SITE
# ============================================
BUATQRIS_BASE_URL=https://api.buatqris.site
BUATQRIS_ACCOUNT=user_xxxxxxxxxxxxxx.xxxxxxxx
BUATQRIS_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# ADMIN LOGIN (modal login lewat tombol logo "R")
# ============================================
ADMIN_USERNAME=ganti_username_admin
ADMIN_PASSWORD=ganti_password_admin_min_12_karakter

# ============================================
# SESSION SECRET
# String acak panjang untuk menandatangani cookie sesi (auth custom).
# Generate contoh: openssl rand -hex 32
# ============================================
SESSION_SECRET=ganti_dengan_string_acak_panjang

# ============================================
# WHATSAPP CS (opsional, sudah dihardcode di UI, hanya untuk referensi)
# ============================================
NEXT_PUBLIC_WA_CS=083169147017
